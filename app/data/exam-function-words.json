[
  {
    "sourceIndex": 1,
    "character": "而",
    "kind": "虚词",
    "entries": [
      {
        "sourceItem": 1,
        "sourceLabel": "2023·新高考卷Ⅰ",
        "year": 2023,
        "paragraphs": [
          "赏一人而天下为人臣者莫敢失礼矣     连词，表承接",
          "奖赏一个人就能使天下做臣子的没有敢失礼的了"
        ]
      },
      {
        "sourceItem": 2,
        "sourceLabel": "2023·新高考卷Ⅰ",
        "year": 2023,
        "paragraphs": [
          "韩子立法，其所以异夫子之论者纷如也。予每探其意而校其事，持久历远，遏奸劝善，韩氏未必非，孔氏未必得也。持久历远    连词，表递进，并且",
          "韩非子制定的法律，有太多和夫子的理论截然不同之处。我经常探索他们的意图并且比对他们的行为，经过长时间的观察，我发现他们在止恶劝善这方面，韩氏未必是错的，孔氏也未必完全正确。"
        ]
      },
      {
        "sourceItem": 3,
        "sourceLabel": "2022·全国乙卷",
        "year": 2022,
        "paragraphs": [
          "武王克殷，召太公而问曰：“将奈其士众何？”    连词，表承接"
        ]
      },
      {
        "sourceItem": 4,
        "sourceLabel": "2022·浙江卷",
        "year": 2022,
        "paragraphs": [
          "故舍有罪而从无罪者，是以耻劝之也；去轻赏而就重赏者，是以义劝之也。盖欲其思而得之也。    连词，表承接",
          "因此舍弃有罪的行为却判定无罪，是用羞耻来进行勉励；舍弃轻赏却施予重赏，是用道义来进行勉励。大约都是想要百姓自行思考而后领悟到啊。"
        ]
      },
      {
        "sourceItem": 5,
        "sourceLabel": "2021·全国卷Ⅰ",
        "year": 2021,
        "paragraphs": [
          "此乃忍小忿而存大信也    连词，表并列，不译",
          "这正是忍耐小的愤怒保全了大的信用啊。"
        ]
      },
      {
        "sourceItem": 6,
        "sourceLabel": "2021·新高考卷Ⅱ",
        "year": 2021,
        "paragraphs": [
          "逖不报书，而听其互市，收利十倍    连词，表并列，而是",
          "祖逖没有回复这封信，而是听凭双方民间互相贸易，收取十倍的利润。"
        ]
      },
      {
        "sourceItem": 7,
        "sourceLabel": "2020·新高考卷Ⅱ",
        "year": 2020,
        "paragraphs": [
          "小民罢市。丧出江上，白衣冠送者夹岸，酹而哭者百里不绝  连词，表修饰",
          "市民停业悼念。灵柩经过江面，民众穿戴白衣帽两岸送行，边洒酒祭奠边哭着的人百里不绝。"
        ]
      },
      {
        "sourceItem": 8,
        "sourceLabel": "2019·全国卷Ⅰ",
        "year": 2019,
        "paragraphs": [
          "上因感鬼神事，而问鬼神之本  连词，表目的     （因果的果 ？）",
          "文帝因为有感于鬼神之事，便询问鬼神的本源。"
        ]
      }
    ]
  },
  {
    "sourceIndex": 2,
    "character": "何",
    "kind": "虚词",
    "entries": [
      {
        "sourceItem": 1,
        "sourceLabel": "2023·全国甲卷",
        "year": 2023,
        "paragraphs": [
          "古之贫无以葬者或然，今子何自苦？ 疑问副词，为什么",
          "古代贫穷无法安葬逝者的人或许会这样做，现在你为什么让自己这么辛苦（亲自负土葬母）呢？"
        ]
      },
      {
        "sourceItem": 2,
        "sourceLabel": "2021·浙江卷",
        "year": 2021,
        "paragraphs": [
          "既师其意，又师其辞，何患？ 疑问代词，什么",
          "（我）学习他们的精神，又学习他们的文词，还担心什么呢？"
        ]
      },
      {
        "sourceItem": 3,
        "sourceLabel": "2019·江苏卷",
        "year": 2019,
        "paragraphs": [
          "每至丙夜，声琅琅不辍。家人笑之：“老博士何以书为？” 表疑问，什么",
          "打开书，像书虫一样沉浸其中，每天到了深夜读书声也不停。家人笑话他说：“老博士看书干什么？”"
        ]
      },
      {
        "sourceItem": 4,
        "sourceLabel": "2018·全国卷Ⅲ",
        "year": 2018,
        "paragraphs": [
          "纯礼曰：“草湿则生火，何足怪！” 疑问代词，译为“什么” （哪里？反问）",
          "纯礼说：“草湿了就会生出火来，这有什么值得奇怪呢！”"
        ]
      },
      {
        "sourceItem": 5,
        "sourceLabel": "2017·全国卷Ⅲ",
        "year": 2017,
        "paragraphs": [
          "申饬边臣岂不可，何以使为 表示疑问或诘问，什么",
          "这件事情，命令守边的大臣去做还不行吗？为何还要出使呢？”"
        ]
      }
    ]
  },
  {
    "sourceIndex": 3,
    "character": "乎",
    "kind": "虚词",
    "entries": [
      {
        "sourceItem": 1,
        "sourceLabel": "2023·全国甲卷",
        "year": 2023,
        "paragraphs": [
          "是可以无去取乎？ 助词，表反问语气。相当于“吗”",
          "这样看来，我们还能不经过筛选地获取知识吗？"
        ]
      },
      {
        "sourceItem": 2,
        "sourceLabel": "2022·新高考卷Ⅰ",
        "year": 2022,
        "paragraphs": [
          "可得闻乎？ 表疑问，相当于“吗”"
        ]
      },
      {
        "sourceItem": 3,
        "sourceLabel": "2019·北京卷",
        "year": 2019,
        "paragraphs": [
          "天地之无倪，阴阳之无穷，以澒洞轇轕乎其中 介词，在",
          "天地无边际，阴阳二气变化无穷尽，同时充满在茫茫无际广阔深远的天地之间"
        ]
      },
      {
        "sourceItem": 4,
        "sourceLabel": "2018·浙江卷",
        "year": 2018,
        "paragraphs": [
          "世之所谓大儒，果足以充儒之名乎？ 助词，表反问语气。相当于“吗”"
        ]
      },
      {
        "sourceItem": 5,
        "sourceLabel": "2018·江苏卷",
        "year": 2018,
        "paragraphs": [
          "闻伯夷、柳下惠之风者，奋乎①百世之下，而况于亲炙之者乎②？",
          "①助词，用在句中起缓和语气作用或表示语气的停顿　②助词，表反问语气。相当于“呢”",
          "伯夷、柳下惠那样的高风，百代之后的人听到，也能奋发，更何况亲受熏陶的人呢？"
        ]
      }
    ]
  },
  {
    "sourceIndex": 4,
    "character": "乃",
    "kind": "虚词",
    "entries": [
      {
        "sourceItem": 1,
        "sourceLabel": "2023·新高考卷Ⅰ",
        "year": 2023,
        "paragraphs": [
          "后悼公十四年，知氏乃亡 副词，才      后来在悼公十四年，知氏才灭亡。"
        ]
      },
      {
        "sourceItem": 2,
        "sourceLabel": "2022·全国甲卷",
        "year": 2022,
        "paragraphs": [
          "张仪知楚绝齐也，乃出见使者曰：“从某至某，广从六里。” 副词，才",
          "张仪知道楚国与齐国断了交，才出来接见使者说：“从某地到某地，纵横六里。”"
        ]
      },
      {
        "sourceItem": 3,
        "sourceLabel": "2019·全国卷Ⅱ",
        "year": 2019,
        "paragraphs": [
          "国内空，日以削，恐，乃使使割河西之地，献于秦以和 连词，于是，就",
          "魏惠王因军队屡次败于齐国、秦国，国内十分空虚，一天一天地衰落，非常恐慌，于是派遣使者割让河西之地，奉送给秦国来求和。"
        ]
      },
      {
        "sourceItem": 4,
        "sourceLabel": "2019·全国卷Ⅰ",
        "year": 2019,
        "paragraphs": [
          "廷尉乃言贾生年少，颇通诸子百家之书  副词，就"
        ]
      },
      {
        "sourceItem": 5,
        "sourceLabel": "2018·全国卷Ⅲ",
        "year": 2018,
        "paragraphs": [
          "陵寝皆在邑境，岁时缮治无虚日，今乃与百县均赋，曷若置此表转折，却、竟然"
        ]
      },
      {
        "sourceItem": 6,
        "sourceLabel": "2018·江苏卷",
        "year": 2018,
        "paragraphs": [
          "钱故当时东道主，其父鸣和癯而髯，接三貌似之，与谈乃父事，转不甚晓",
          "第三人称代词，他的      钱接三（钱故）是当时的东道主，他的父亲钱鸣和瘦且两腮长有胡子，钱接三在容貌上很像他的父亲，与他谈起他父亲的事，接三不太清楚。"
        ]
      },
      {
        "sourceItem": 7,
        "sourceLabel": "2017·浙江卷",
        "year": 2017,
        "paragraphs": [
          "使圣人微旨不传，乃郑玄辈为注解之罪  副词，表判断，是",
          "假使圣人的精深微妙的意旨不能传达，就是郑玄等写注释的人的罪过。"
        ]
      }
    ]
  },
  {
    "sourceIndex": 5,
    "character": "其",
    "kind": "虚词",
    "entries": [
      {
        "sourceItem": 1,
        "sourceLabel": "2023·新高考卷Ⅰ",
        "year": 2023,
        "paragraphs": [
          "请略说一隅，而君子审其信否焉  代词，相当于“它”",
          "请允许我简略地说其中的一小部分，您来仔细考察它真实与否。"
        ]
      },
      {
        "sourceItem": 2,
        "sourceLabel": "2022·全国甲卷",
        "year": 2022,
        "paragraphs": [
          "楚王不听，曰：“吾事善矣！子其弭口无言，以待吾事。” 副词，表命令语气",
          "楚王不听从，说：“我的事办好了！你还是闭嘴不言，来等待我的好事吧。”"
        ]
      },
      {
        "sourceItem": 3,
        "sourceLabel": "2021·新高考卷Ⅰ",
        "year": 2021,
        "paragraphs": [
          "君恶闻其过则忠化为佞  第一人称代词，自己的",
          "君主讨厌听人揭自己的短，则大臣的忠诚便转化为谄谀；"
        ]
      },
      {
        "sourceItem": 4,
        "sourceLabel": "2021·新高考卷Ⅱ",
        "year": 2021,
        "paragraphs": [
          "逖不报书，而听其互市，收利十倍 第三人称代词，他们，指双方民间",
          "祖逖没有回复这封信，而是听凭双方民间互相贸易，收取十倍的利润。"
        ]
      },
      {
        "sourceItem": 5,
        "sourceLabel": "2020·浙江卷",
        "year": 2020,
        "paragraphs": [
          "而后四方学者，始耻其旧而惟古之求 第三人称代词，他们",
          "后来各地求学的人，开始以他们原有的文风为耻辱，只追求古文。"
        ]
      },
      {
        "sourceItem": 6,
        "sourceLabel": "2019·全国卷Ⅰ",
        "year": 2019,
        "paragraphs": [
          "于是天子后亦疏之(贾谊)，不用其议  代词，他的"
        ]
      },
      {
        "sourceItem": 7,
        "sourceLabel": "2019·北京卷",
        "year": 2019,
        "paragraphs": [
          "阴阳之无穷，以澒洞轇轕乎其中，或会或离，或吸或吹，如轮如机，其孰能知之？ 副词，表反问      阴阳二气，充满于茫茫无际的天地之间，有时聚集，有时分散，有时互相吸引，有时互相排斥，好像车轮滚动，好像纺机运转，（它们的变化）难道我们能够知道吗？"
        ]
      },
      {
        "sourceItem": 8,
        "sourceLabel": "2018·天津卷",
        "year": 2018,
        "paragraphs": [
          "兼而有者，其吾友杨君乎？ 表揣测语气，或许、大概",
          "（有人只能乐山水，多高情；有人只能忧黎庶，有善政）同时具有这些，大概是我的朋友杨汉公了。"
        ]
      }
    ]
  },
  {
    "sourceIndex": 6,
    "character": "且",
    "kind": "虚词",
    "entries": [
      {
        "sourceItem": 1,
        "sourceLabel": "2023·全国甲卷",
        "year": 2023,
        "paragraphs": [
          "执母丧，倚庐三年，席薪枕块，虽疾病不饮酒食肉。或勉之以礼，曰：“《礼》‘老病不止酒肉’，意或不胜丧耳。病且未老，忍及此耶？”   连词，表示转折，相当于“却”",
          "母亲去世后，他结草庐守孝三年，睡在柴草上，枕在土块上，即使生病也不饮酒吃肉。有人劝他按照礼仪规矩适度保重，他说：“《礼记》上说‘老年多病可以不停止吃酒肉’，也许是因为忍受不了丧亲之痛罢了。我虽然病了但还没有年老，能忍心像这样做吗？”"
        ]
      },
      {
        "sourceItem": 2,
        "sourceLabel": "2023·全国乙卷",
        "year": 2023,
        "paragraphs": [
          "重耳即位三年，举兵而伐曹矣，因令人告曹君曰：“悬叔瞻而出之，我且杀而以为大戮。”   副词，将要     重耳登基三年，就发兵攻打曹国了。于是派人告诉曹君说：“把叔瞻从城上吊下来，我将杀掉他陈尸示众。”"
        ]
      },
      {
        "sourceItem": 3,
        "sourceLabel": "2022·新高考卷Ⅰ",
        "year": 2022,
        "paragraphs": [
          "秦将伐魏，魏王闻之，夜见孟尝君，告之曰：“秦且攻魏，子为寡人谋，奈何？”副词，将要     秦国将要讨伐魏国。魏王听说，连夜去见孟尝君，告诉他说：“秦国将要进攻魏国了，您替寡人谋划一下，怎么办？”"
        ]
      },
      {
        "sourceItem": 4,
        "sourceLabel": "2021·浙江卷",
        "year": 2021,
        "paragraphs": [
          "且嗜退之文辞，欲诱人同所乐也。” 表并列关系，译为“并且”",
          "并且（我）喜好韩愈的文章，想诱导他人与自己一样喜爱。"
        ]
      },
      {
        "sourceItem": 5,
        "sourceLabel": "2019·北京卷",
        "year": 2019,
        "paragraphs": [
          "(伯阳父)且曰：“源塞，国必亡……不过其纪。” 表递进，还",
          "(伯阳父)还说：“水源堵塞了，国家一定要灭亡……‘天既要抛弃一个国家，不会超过十年’。”"
        ]
      },
      {
        "sourceItem": 6,
        "sourceLabel": "2018·江苏卷",
        "year": 2018,
        "paragraphs": [
          "遂忘作客，兼忘其身之老且衰也  表递进关系，译为“而且”“并且”",
          "于是忘记了自己是作客，同时忘了自己身体已经老而且衰弱了。"
        ]
      },
      {
        "sourceItem": 7,
        "sourceLabel": "2017·全国卷Ⅱ",
        "year": 2017,
        "paragraphs": [
          "憙以因疾报杀，非仁者心，且释之而去 副词，译为“暂且”",
          "（赵憙报仇。可是仇人们全部生了病，没有人抵抗。）赵憙认为乘别人生病报仇杀人，不是仁爱的人所应做的，就暂且放过他们而离开了。"
        ]
      }
    ]
  },
  {
    "sourceIndex": 7,
    "character": "若",
    "kind": "虚词",
    "entries": [
      {
        "sourceItem": 1,
        "sourceLabel": "2023·全国乙卷",
        "year": 2023,
        "paragraphs": [
          "此若反国，必诛无礼，则曹其首也 连词，表假设，如果",
          "他如果返回晋国，一定会讨伐对他无礼的人，那曹就是那第一个了。"
        ]
      },
      {
        "sourceItem": 2,
        "sourceLabel": "2019·北京卷",
        "year": 2019,
        "paragraphs": [
          "夫天地之气，不失其序；若过其序，民乱之也。  连词，表假设，如果",
          "天地间的阴阳二气，不能错乱了位置；如果错乱了，那是被人搅乱的。"
        ]
      },
      {
        "sourceItem": 3,
        "sourceLabel": "2018·全国卷Ⅰ",
        "year": 2018,
        "paragraphs": [
          "若挟天子保许昌，杖大威以羽檄征四方兵，孰敢不从 连词，表假设，译为“如果”",
          "如果挟天子保住许昌，依仗帝王的威仪，号令天下征讨天下，谁敢不听从您呢！"
        ]
      },
      {
        "sourceItem": 4,
        "sourceLabel": "2017·天津卷",
        "year": 2017,
        "paragraphs": [
          "其论说始若诡于众，极听其终，众乃是之。副词，好像、似乎",
          "他的言论初听时似乎很古怪，与众不同，直到把他的话听完了，大家才认为说得很正确。"
        ]
      },
      {
        "sourceItem": 4,
        "sourceLabel": "2016·全国卷Ⅱ",
        "year": 2016,
        "paragraphs": [
          "与其误用而斥之，不若慎于始进。 副词，如",
          "与其因误用而贬退，不如谨慎地考察人选。"
        ]
      }
    ]
  },
  {
    "sourceIndex": 8,
    "character": "所",
    "kind": "虚词",
    "entries": [
      {
        "sourceItem": 1,
        "sourceLabel": "2023·新高考卷Ⅰ",
        "year": 2023,
        "paragraphs": [
          "信诬说以疑圣，殆非所望也 放动词前，构成名词性词组 ，“……的事”",
          "相信谎言而怀疑圣人，恐怕不是我所期望的。"
        ]
      },
      {
        "sourceItem": 2,
        "sourceLabel": "2021·浙江卷",
        "year": 2021,
        "paragraphs": [
          "且嗜退之文辞，欲诱人同所乐也 放动词前，构成名词性词组，“……的文章”",
          "并且（我）喜好韩愈的文章，想诱导他人，共同喜爱相同的文章。"
        ]
      },
      {
        "sourceItem": 3,
        "sourceLabel": "2020·新高考卷Ⅰ",
        "year": 2020,
        "paragraphs": [
          "都御史周应秋犹以所司承追不力，疏趣之，由是诸人家族尽破",
          "放动词前，构成名词性词组，“……的官员”    都御史周应秋还认为主管官员受命追查不力，上疏催促此事，因而使左光斗亲属各家族全都家破人亡。"
        ]
      },
      {
        "sourceItem": 4,
        "sourceLabel": "2019·全国卷Ⅰ",
        "year": 2019,
        "paragraphs": [
          "每诏令议下，诸老先生不能言，贾生尽为之对，人人各如其意所欲出 放在动词前，构成所字结构，“……的话”      每当皇帝诏令臣下商议政事，各位老先生往往无言答对，而贾谊却总是答得很完满，人人都感到贾谊所讲的话，正是自己所要说的。"
        ]
